@model Labb1_PokeAPI.Models.PokemonListResult

<h1 class="mb-4 text-center">Pokémon</h1>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger text-center" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<form asp-action="Search" method="get" class="d-flex justify-content-center mb-4">
    <input type="text" name="query" class="form-control w-25 me-2" placeholder="Sök Pokémon..." />
    <button type="submit" class="btn btn-primary">Sök</button>
</form>

<div class="row row-cols-2 row-cols-md-4 row-cols-lg-5 g-3">
    @foreach (var pokemon in Model.Items)
    {
    <a asp-action="Details" asp-route-nameOrId="@pokemon.Name" class="text-decoration-none">
        <div class="card h-100 text-center shadow-sm pokemon-card">
            <div class="card-body d-flex align-items-center justify-content-center">
                <h5 class="card-title text-capitalize mb-0">@pokemon.Name #@pokemon.Id</h5>
            </div>
        </div>
    </a>
    }
</div>

<div class="d-flex justify-content-between mt-4">
    @if (Model.HasPrevious)
    {
        <a asp-action="Index" asp-route-offset="@Model.PreviousOffset" class="btn btn-outline-secondary">&larr;Föregående</a>
    }
    else
    {
        <span></span>
    }

    @if (Model.HasNext)
    {
        <a asp-action="Index" asp-route-offset="@Model.NextOffset" class="btn btn-outline-secondary">Nästa &rarr;</a>
    }
    else
    {
        <span></span>
    }
    
</div>

<style>
    .pokemon-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        min-height: 80px;
    }

        .pokemon-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.2) !important;
        }

</style>

